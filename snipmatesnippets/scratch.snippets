snippet svc "Service Cloud Features"
  "PersonAccounts","ServiceCloud","ServiceUser","LiveAgent","LightningServiceConsole","EinsteinAnalyticsPlus","CustomNotificationType","Entitlements","SocialCustomerService","Sites"

