  "liveAgentSettings":{
    "enableLiveAgent": true
  }

snippet comm "Communities Settings"
  "communitiesSettings":{
    "enableNetworksEnabled": true


snippet notes "Enable Notes Settings"
  "enhancedNotesSettings":{
